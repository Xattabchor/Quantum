From d3a99995f56d8509f03b92307f1fc8bb7bb56b8b Mon Sep 17 00:00:00 2001
From: arena-agent <agent@arena.ai>
Date: Thu, 5 Nov 2026 17:57:24 +0000
Subject: [PATCH] Make config/resource loading null-safe

- IniFile tolerates a null/empty config text and keys before the first [group]
- StringTools.openResource is the single guarded resource lookup
- parseInt/parseByte/parseFloat/parseLong return the type default for null
  instead of throwing NPE during MIDlet startup
---
 src/code/utils/IniFile.java     | 37 +++++++++++++++------
 src/code/utils/StringTools.java | 57 ++++++++++++++++++++++++++++++---
 2 files changed, 79 insertions(+), 15 deletions(-)

diff --git a/src/code/utils/IniFile.java b/src/code/utils/IniFile.java
index 607838a..1331cd1 100644
--- a/src/code/utils/IniFile.java
+++ b/src/code/utils/IniFile.java
@@ -20,8 +20,9 @@ public class IniFile {
     }
     
     public static Object[] createGroups(String file) {
-        file = StringTools.getStringFromResource(file);
-        String[] lines = StringTools.cutOnStrings(file, '\n');
+        String text = StringTools.getStringFromResource(file);
+        String[] lines = (text == null) ? new String[0] : StringTools.cutOnStrings(text, '\n');
+        if(lines == null) lines = new String[0];
         return createGroups(lines);
     }
     
@@ -46,7 +47,14 @@ public class IniFile {
                 //Value
                 String key = line.substring(0, charIndex).trim();
                 String val = line.substring(charIndex + 1).trim();
-                
+
+                if(currentGroup == null) {
+                    // Keys before the first [group] used to throw: keep them in
+                    // a group named "" instead of dying on a valid file.
+                    currentGroup = new Hashtable();
+                    allGroups.addElement(new IniFile(currentGroup));
+                    groupsNames.addElement("");
+                }
                 currentGroup.put(key, val);
             }
         }
@@ -91,7 +99,10 @@ public class IniFile {
     
     public IniFile(String str, boolean keys) {
         hashtable = new Hashtable();
-        String[] lines = StringTools.cutOnStrings(str, '\n');
+        // A missing or unreadable config resource used to be a NullPointerException
+        // inside cutOnStrings. An empty map is the correct "no settings" state.
+        String[] lines = (str == null) ? new String[0] : StringTools.cutOnStrings(str, '\n');
+        if(lines == null) lines = new String[0];
         set(lines, keys);
     }
     
@@ -101,25 +112,31 @@ public class IniFile {
     }
     
     public void set(String[] lines, boolean useGroups) {
+        // Root keys live directly in `hashtable` (global zone); a [group] creates
+        // a nested map. A key before any [group] with useGroups=false is a root key.
         Hashtable currentGroup = hashtable;
-        
+
+        if(lines == null) return;
+
         for(int i=0; i<lines.length; i++) {
             String line = lines[i];
-            if(line.length() <= 0) continue;
+            if(line == null || line.length() <= 0) continue;
             if(line.startsWith("#") || line.startsWith(";")) continue;
-            
+
             int charIndex;
-            if(line.charAt(0) == '[' && useGroups) {
+            if(line.charAt(0) == '[' && useGroups && line.length() > 2
+                    && line.charAt(line.length() - 1) == ']') {
                 //Group
                 String group = line.substring(1, line.length() - 1);
                 currentGroup = new Hashtable();
-                
+
                 hashtable.put(group, currentGroup);
             } else if ((charIndex = line.indexOf('=')) >= 0) {
                 //Value
                 String key = line.substring(0, charIndex).trim();
                 String val = line.substring(charIndex + 1).trim();
-                
+
+                if(currentGroup == null) currentGroup = hashtable;
                 currentGroup.put(key, val);
             }
         }
diff --git a/src/code/utils/StringTools.java b/src/code/utils/StringTools.java
index 77e9101..92c7a3f 100644
--- a/src/code/utils/StringTools.java
+++ b/src/code/utils/StringTools.java
@@ -5,11 +5,32 @@ import java.util.Vector;
 
 public class StringTools {
 
+    /**
+     * Packaged text resource, or null when it is absent.
+     *
+     * A null stream used to become a NullPointerException inside IniFile during
+     * startup, so the lookup itself is guarded and tries both the MIDlet's own
+     * loader and the bootstrap loader. CLDC 1.1 has no Class.getClassLoader, so
+     * these two calls are the whole lookup surface on a handset.
+     */
+    public static InputStream openResource(String file) {
+        if(file == null) return null;
+        try {
+            InputStream is = StringTools.class.getResourceAsStream(file);
+            if(is != null) return is;
+            if(file.startsWith("/")) return StringTools.class.getResourceAsStream(file.substring(1));
+            return StringTools.class.getResourceAsStream("/" + file);
+        } catch(Throwable ignored) {
+            return null;
+        }
+    }
+
     public static String getStringFromResource(String file) {
         InputStream is = null;
 
         try {
-            is = (new Object()).getClass().getResourceAsStream(file);
+            is = openResource(file);
+            if(is == null) return null;
             StringBuffer str = new StringBuffer();
 
             while(true) {
@@ -88,14 +109,30 @@ public class StringTools {
     }
     
     public static float parseFloat(String val) {
-        return Float.parseFloat(val.trim());
+        if(val == null) return 0.0f;
+        try {
+            return Float.parseFloat(val.trim());
+        } catch(NumberFormatException exc) {
+            return 0.0f;
+        }
     }
     //#endif
+    /**
+     * Number or 0. A missing settings key used to arrive here as null and take
+     * the whole MIDlet down during init(); callers that care use the (key, def)
+     * variants, this one is the forgiving default.
+     */
     public static int parseInt(String val) {
-        return Integer.parseInt(val.trim());
+        if(val == null) return 0;
+        try {
+            return Integer.parseInt(val.trim());
+        } catch(NumberFormatException exc) {
+            return 0;
+        }
     }
     
     public static int cleverParseInt(String val) {
+        if(val == null) return 0;
         val = val.trim();
         int ind = val.indexOf('.');
         if(ind > -1) val = val.substring(0, ind); //floating point -> integer
@@ -103,11 +140,21 @@ public class StringTools {
     }
     
     public static byte parseByte(String val) {
-        return Byte.parseByte(val.trim());
+        if(val == null) return 0;
+        try {
+            return Byte.parseByte(val.trim());
+        } catch(NumberFormatException exc) {
+            return 0;
+        }
     }
     
     public static long parseLong(String val) {
-        return Long.parseLong(val.trim());
+        if(val == null) return 0L;
+        try {
+            return Long.parseLong(val.trim());
+        } catch(NumberFormatException exc) {
+            return 0L;
+        }
     }
     
     public static boolean isNumeric(String s) {
